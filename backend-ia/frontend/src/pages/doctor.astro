---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---
<BaseLayout title="Dashboard Médico - OpenS">
<Navbar />
<main class="max-w-4xl mx-auto px-4 py-16 text-center">
  <div class="animate-fade-in">
    <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-cyan-500 to-indigo-600 flex items-center justify-center mx-auto mb-6 animate-glow shadow-lg shadow-cyan-500/20">
      <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
    </div>
    <h1 class="text-4xl font-extrabold text-slate-900 mb-3">Dashboard Médico</h1>
    <p class="text-slate-600 mb-8 max-w-md mx-auto">El asistente IA es ahora el corazón del dashboard. Accede al flujo completo de consulta con IA, voz y blockchain.</p>

    <div class="grid md:grid-cols-3 gap-4 mb-10">
      <div class="p-5 rounded-xl glass border border-slate-200 text-center">
        <p class="text-3xl font-extrabold text-cyan-400 animate-counter" id="stat-patients">—</p>
        <p class="text-xs text-slate-500 mt-1">Pacientes</p>
      </div>
      <div class="p-5 rounded-xl glass border border-slate-200 text-center">
        <p class="text-3xl font-extrabold text-indigo-400 animate-counter" id="stat-records">—</p>
        <p class="text-xs text-slate-500 mt-1">Registros</p>
      </div>
      <div class="p-5 rounded-xl glass border border-slate-200 text-center">
        <p class="text-3xl font-extrabold text-emerald-400 animate-counter" id="stat-ai">—</p>
        <p class="text-xs text-slate-500 mt-1">Motor IA</p>
      </div>
    </div>

    <a href="/asistente" class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-cyan-500 to-indigo-600 text-white rounded-2xl text-lg font-bold shadow-lg shadow-cyan-500/25 hover:shadow-xl hover:-translate-y-1 transition-all">
      Ir al Dashboard IA
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
    </a>
  </div>
</main>
</BaseLayout>

<script>
  const API='/api/v1';
  async function af(p:string){try{const r=await fetch(p);if(r.ok)return await r.json();}catch{}try{const r=await fetch(`http://localhost:8001${p}`);if(r.ok)return await r.json();}catch{}return null;}
  (async()=>{
    const data=await af(`${API}/patients`);const ps=data?.patients||[];
    document.getElementById('stat-patients')!.textContent=String(ps.length);
    const health=await af('/health');
    document.getElementById('stat-ai')!.textContent=health?.google_ai_configured?'Gemini':'Ollama';
    let total=0;for(const p of ps){const r=await af(`${API}/patients/${p.id}/records`);total+=(r?.records||[]).length;}
    document.getElementById('stat-records')!.textContent=String(total);
  })();
</script>
