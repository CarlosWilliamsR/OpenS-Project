---
/**
 * asistente.astro — Doctor Dashboard (Heart of the Application)
 *
 * WHY ASTRO: Astro renders this page as static HTML at build time (0 JS overhead
 * for the shell). Only the interactive islands (chat, search, voice) hydrate on
 * the client. This results in <100ms First Contentful Paint on clinical networks.
 *
 * ARCHITECTURE: Modular component composition:
 *   <PatientInfo />      → Doctor profile + patient list/search
 *   <ChatBox />          → AI chat with skeleton loaders + streaming
 *   <ResilienceMonitor /> → Real-time Cloud/Local/Offline indicator
 *   <VoiceControls />    → ElevenLabs TTS + Solana anchoring
 *
 * DATA FLOW: patientService.js (resilient fetch) → FastAPI → Supabase
 * BLOCKCHAIN: solanaService.js (burner wallet) → Solana Devnet MemoProgram
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ResilienceMonitor from '../components/ResilienceMonitor.astro';
import PatientInfo from '../components/PatientInfo.astro';
import ChatBox from '../components/ChatBox.astro';
import VoiceVisualizer from '../components/VoiceVisualizer.astro';
import DiagnosisEditor from '../components/DiagnosisEditor.astro';
import ClinicalClosurePanel from '../components/ClinicalClosurePanel.astro';
import SolanaStatus from '../components/SolanaStatus.astro';
---
<BaseLayout title="Dashboard Médico - OpenS">
<Navbar />
<main class="max-w-[1600px] mx-auto px-4 py-4">
  <div class="grid grid-cols-12 gap-4 items-start">
    
    <!-- Left Column: Patient Profile + History (Timeline) -->
    <div class="col-span-12 xl:col-span-3 flex flex-col gap-4">
      <PatientInfo />
      <DiagnosisEditor />
    </div>

    <!-- Center Column: AI Assistant (Zero-Friction Chat) -->
    <div class="col-span-12 xl:col-span-6 flex flex-col bg-white border-technical rounded-none overflow-hidden relative min-h-[680px]">
      <ChatBox />
    </div>

    <!-- Right Column: System Health & Hardware Sensors -->
    <div class="col-span-12 xl:col-span-3 flex flex-col gap-4">
      <ResilienceMonitor />
      <ClinicalClosurePanel />
      
      <div class="medical-card p-4">
        <h3 class="medical-label mb-4">Pipeline Status: Mission Control</h3>
        
        <div id="pipeline-steps-ui" class="space-y-3 mb-6 font-mono">
           {[
             { id: 'step-ai', label: 'GEN_AI_DIAGNOSIS', icon: '>>' },
             { id: 'step-voice', label: 'TTS_ELEVEN_LABS', icon: '>>' },
             { id: 'step-solana', label: 'BLOCKCHAIN_HASH', icon: '>>' },
             { id: 'step-db', label: 'SUPABASE_SYNC_OK', icon: '>>' }
           ].map(step => (
             <div id={`step-row-${step.id}`} class="flex items-center gap-2 opacity-30 grayscale transition-all text-[10px]">
              <span class="text-blue-600 font-bold">{step.icon}</span>
              <span class="font-bold text-slate-500">{step.label}</span>
              <div id={`step-dot-${step.id}`} class="ml-auto w-1.5 h-1.5 bg-slate-300"></div>
             </div>
           ))}
        </div>

        <div id="pipeline-status-bar" class="hidden h-[2px] bg-slate-100 overflow-hidden mb-4">
          <div id="pipeline-progress" class="h-full bg-blue-600 w-0 transition-all duration-500"></div>
        </div>

        <VoiceVisualizer />
        <SolanaStatus />
      </div>
    </div>

  </div>
</main>
<div id="toast-container" class="fixed top-16 right-4 z-50 flex flex-col items-end gap-2"></div>
</BaseLayout>

<script>
import patientService from '../services/patientService.js';
import { hashDiagnosis, anchorOnChain } from '../services/solanaService.js';
import { jsPDF } from 'jspdf';

let currentPatient: any = null;
let conversation: any[] = [];
let isLoading = false;

const $ = (id:string) => document.getElementById(id)!;

// --- DOM References ---
const chatMessages = $('chat-messages');
const chatForm = $('chat-form') as HTMLFormElement;
const chatInput = $('chat-input') as HTMLInputElement;
const sendBtn = $('send-btn');
const aiBadge = $('ai-badge');
const patientLabel = $('patient-label');
const localModelSelect = $('local-model-select') as HTMLSelectElement;
const draftOutput = $('draft-output') as HTMLTextAreaElement;
const reasonInput = $('reason-input') as HTMLTextAreaElement;
const finalDiagnosisInput = $('final-diagnosis-input') as HTMLTextAreaElement;
const audioSummaryBtn = $('audio-summary-btn');
const downloadPdfBtn = $('download-pdf-btn');
const downloadPdfBasicBtn = $('download-pdf-basic-btn');
const voiceAudio = $('voice-audio') as HTMLAudioElement;
const replyModeAudioBtn = $('reply-mode-audio') as HTMLButtonElement;
const replyModeTextBtn = $('reply-mode-text') as HTMLButtonElement;
const historyPdfContainer = $('history-pdf-container');
const downloadHistoryPdfBtn = $('download-history-pdf-btn') as HTMLButtonElement;
const searchInput = $('patient-search') as HTMLInputElement;
const searchResults = $('search-results');
const searchContainer = $('search-container');
const searchHint = $('patient-search-hint');
const supabaseSyncBadge = document.getElementById('supabase-sync-badge');

let allPatients: any[] = [];
let currentRecords: any[] = [];
let searchDebounceTimer: ReturnType<typeof setTimeout> | null = null;
let activeSearchController: AbortController | null = null;
let replyMode: 'audio' | 'text' = 'audio';
let isGeneratingClinicalPdf = false;
let isGeneratingHistoryPdf = false;

// --- Helper: Toast System ---
function showToast(msg:string, type:'success'|'error'|'info'='info') {
  const container = $('toast-container');
  const el = document.createElement('div');
  const colors = { success: 'bg-slate-900 text-white', error: 'bg-red-600 text-white', info: 'bg-blue-600 text-white' };
  el.className = `${colors[type]} px-6 py-4 rounded-2xl shadow-2xl text-sm font-bold animate-slide-in border border-white/10 transition-opacity duration-500`;
  el.textContent = msg;
  container.appendChild(el);
  setTimeout(() => { 
    el.style.opacity = '0'; 
    setTimeout(() => el.remove(), 500); 
  }, 4000);
}

// --- Helper: Chat Rendering ---
function renderMd(t:string){
  return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/^## (.*)$/gm,'<h4 class="font-bold text-slate-800 mt-3 mb-1">$1</h4>')
    .replace(/\*\*(.*?)\*\*/g,'<strong class="text-blue-600">$1</strong>')
    .replace(/^- (.*)$/gm,'<li class="ml-4 mb-1">$1</li>')
    .replace(/\n/g,'<br/>');
}

function setReplyMode(mode:'audio'|'text') {
  replyMode = mode;
  if (replyModeAudioBtn && replyModeTextBtn) {
    if (mode === 'audio') {
      replyModeAudioBtn.className = 'px-3 py-1.5 rounded-lg text-[11px] font-black uppercase tracking-wider transition-colors bg-blue-600 text-white shadow-sm';
      replyModeTextBtn.className = 'px-3 py-1.5 rounded-lg text-[11px] font-black uppercase tracking-wider transition-colors text-slate-500 hover:text-slate-700';
    } else {
      replyModeTextBtn.className = 'px-3 py-1.5 rounded-lg text-[11px] font-black uppercase tracking-wider transition-colors bg-slate-900 text-white shadow-sm';
      replyModeAudioBtn.className = 'px-3 py-1.5 rounded-lg text-[11px] font-black uppercase tracking-wider transition-colors text-slate-500 hover:text-slate-700';
    }
  }
}

function addMsg(role:'user'|'assistant', text:string){
  const el = document.createElement('div');
  el.className = `flex ${role==='user'?'justify-end':'justify-start'} animate-fade-in`;
  const inner = document.createElement('div');
  inner.className = `max-w-[85%] px-5 py-4 rounded-[1.5rem] text-sm ${role==='user'?'bg-blue-600 text-white rounded-br-none shadow-lg shadow-blue-600/20':'bg-slate-100 text-slate-800 rounded-bl-none'}`;
  inner.innerHTML = text ? renderMd(text) : '<div class="flex gap-1 py-1"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></div>';
  el.appendChild(inner);
  chatMessages.appendChild(el);
  chatMessages.scrollTo({top:chatMessages.scrollHeight, behavior:'smooth'});
  return inner;
}

function streamText(text:string, el:HTMLElement, onDone?:()=>void){
  let i=0; el.innerHTML='';
  const iv=setInterval(() => {
    el.innerHTML = renderMd(text.slice(0,i));
    i += 3;
    if(i >= text.length){
      el.innerHTML = renderMd(text);
      clearInterval(iv);
      if(onDone) onDone();
      chatMessages.scrollTo({top:chatMessages.scrollHeight, behavior:'smooth'});
    }
  }, 20);
}

async function playVoice(text:string){
  try {
    const blob = await patientService.synthesizeVoice(text);
    if(blob){
      voiceAudio.src = URL.createObjectURL(blob);
      voiceAudio.play();
      showToast('🎙️ Reproduciendo audio...', 'info');
    }
  } catch(e) {
    showToast('Error en síntesis de voz', 'error');
  }
}

// --- Pipeline Controller ---
function buildClinicalReport(includeAi:boolean) {
  const reason = reasonInput?.value.trim() || '';
  const finalDiagnosis = finalDiagnosisInput?.value.trim() || '';
  const aiAnalysis = draftOutput?.value.trim() || '';
  const diagnosisForFlow = finalDiagnosis || aiAnalysis;

  return {
    reason,
    finalDiagnosis,
    aiAnalysis,
    diagnosisForFlow,
    printableHtml: `
      <h2 style="color:#0f172a;margin:0 0 8px 0;">Reporte Clínico OpenS</h2>
      <p style="margin:0 0 8px 0;"><strong>Paciente:</strong> ${escapeHtml(currentPatient?.name || `Paciente ${currentPatient?.id || ''}`)}</p>
      <p style="margin:0 0 12px 0;"><strong>ID:</strong> ${escapeHtml(String(currentPatient?.id || ''))}</p>
      <h3 style="margin:16px 0 6px 0;color:#0369a1;">Motivo de llegada</h3>
      <p style="margin:0 0 12px 0;white-space:pre-wrap;">${escapeHtml(reason || 'No especificado')}</p>
      <h3 style="margin:16px 0 6px 0;color:#0369a1;">Diagnóstico final</h3>
      <p style="margin:0 0 12px 0;white-space:pre-wrap;">${escapeHtml(finalDiagnosis || diagnosisForFlow || 'Sin diagnóstico')}</p>
      ${includeAi ? `<h3 style="margin:16px 0 6px 0;color:#16a34a;">Análisis IA</h3><div style="margin-top: 8px;">${renderMd(aiAnalysis || 'No incluido')}</div>` : ''}
    `,
    summaryForStorage: [
      `Motivo de llegada: ${reason || 'No especificado'}`,
      `Diagnóstico final: ${finalDiagnosis || diagnosisForFlow || 'Sin diagnóstico'}`,
      includeAi && aiAnalysis ? `Análisis IA: ${aiAnalysis}` : ''
    ].filter(Boolean).join('\n\n')
  };
}

async function downloadClinicalPdf(includeAi:boolean) {
  if (!currentPatient || isGeneratingClinicalPdf) return;
  isGeneratingClinicalPdf = true;
  const button = includeAi ? downloadPdfBtn : downloadPdfBasicBtn;
  const prevText = button.textContent || (includeAi ? 'PDF con IA' : 'PDF sin IA');
  button.textContent = 'Generando PDF...';
  button.setAttribute('disabled', 'true');

  const report = buildClinicalReport(includeAi);
  let aiAnalysis = report.aiAnalysis;
  if (includeAi && !aiAnalysis) {
    showToast('Generando diagnóstico IA (Gemini/Qwen)...', 'info');
    const contextConversation = conversation.length
      ? conversation
      : [{ role: 'user', content: `Genera un diagnóstico para el paciente ${currentPatient.name || currentPatient.id}.` }];
    const doctorNotes = [
      reasonInput?.value.trim() || '',
      finalDiagnosisInput?.value.trim() || ''
    ].filter(Boolean).join('\n');

    const generated = await patientService.generateDraftDiagnosis(
      currentPatient.id,
      contextConversation as any,
      doctorNotes,
      localModelSelect.value
    );
    aiAnalysis = (generated?.draft_diagnosis || '').trim();
    if (!aiAnalysis || aiAnalysis.toLowerCase().startsWith('error')) {
      showToast('No se pudo generar diagnóstico IA para el PDF.', 'error');
      button.textContent = prevText;
      button.removeAttribute('disabled');
      isGeneratingClinicalPdf = false;
      return;
    }
    draftOutput.value = aiAnalysis;
  }

  const diagnosisForPdf = finalDiagnosisInput?.value.trim() || aiAnalysis || report.diagnosisForFlow;
  if (!report.reason) {
    showToast('Completa el motivo de llegada antes de exportar.', 'info');
    button.textContent = prevText;
    button.removeAttribute('disabled');
    isGeneratingClinicalPdf = false;
    return;
  }
  if (!diagnosisForPdf) {
    showToast('Completa el diagnóstico para exportar el PDF.', 'info');
    button.textContent = prevText;
    button.removeAttribute('disabled');
    isGeneratingClinicalPdf = false;
    return;
  }

  try {
    const doc = new jsPDF({ unit: 'pt', format: 'letter' });
    const left = 40;
    const maxWidth = 530;
    const lineHeight = 16;
    let y = 50;

    const ensureSpace = (needed = 24) => {
      if (y + needed > 760) {
        doc.addPage();
        y = 50;
      }
    };

    const writeLine = (text: string, bold = false, size = 11) => {
      ensureSpace();
      doc.setFont('helvetica', bold ? 'bold' : 'normal');
      doc.setFontSize(size);
      const lines = doc.splitTextToSize(text || '', maxWidth);
      lines.forEach((line: string) => {
        ensureSpace();
        doc.text(line, left, y);
        y += lineHeight;
      });
    };

    writeLine('Reporte Clinico OpenS', true, 18);
    y += 4;
    writeLine(`Paciente: ${currentPatient.name || `Paciente ${currentPatient.id}`}`, true, 12);
    writeLine(`ID: ${currentPatient.id}`, false, 11);
    y += 8;
    writeLine('Motivo de llegada', true, 12);
    writeLine(report.reason || 'No especificado');
    y += 6;
    writeLine('Diagnostico final', true, 12);
    writeLine(diagnosisForPdf);
    if (includeAi) {
      y += 6;
      writeLine('Analisis IA', true, 12);
      writeLine(aiAnalysis || 'No incluido');
    }

    const fileSuffix = includeAi ? 'con_IA' : 'sin_IA';
    doc.save(`OpenS_${currentPatient.name}_${fileSuffix}.pdf`);
    showToast(`PDF ${includeAi ? 'con IA' : 'sin IA'} generado`, 'success');
  } catch (err) {
    console.error('Error generando PDF clínico:', err);
    showToast('No se pudo generar el PDF', 'error');
  } finally {
    button.textContent = prevText;
    button.removeAttribute('disabled');
    isGeneratingClinicalPdf = false;
  }
}

async function downloadHistoryPdf() {
  if (!currentPatient || isGeneratingHistoryPdf) return;
  if (!currentRecords.length) {
    showToast('El paciente no tiene historial para descargar.', 'info');
    return;
  }
  isGeneratingHistoryPdf = true;
  const prevText = downloadHistoryPdfBtn.textContent || 'Descargar historial PDF';
  downloadHistoryPdfBtn.textContent = 'Generando PDF...';
  downloadHistoryPdfBtn.setAttribute('disabled', 'true');

  try {
    const doc = new jsPDF({ unit: 'pt', format: 'letter' });
    const left = 40;
    const maxWidth = 530;
    const lineHeight = 16;
    let y = 50;

    const ensureSpace = (needed = 24) => {
      if (y + needed > 760) {
        doc.addPage();
        y = 50;
      }
    };

    const writeLine = (text: string, bold = false, size = 11) => {
      ensureSpace();
      doc.setFont('helvetica', bold ? 'bold' : 'normal');
      doc.setFontSize(size);
      const lines = doc.splitTextToSize(text || '', maxWidth);
      lines.forEach((line: string) => {
        ensureSpace();
        doc.text(line, left, y);
        y += lineHeight;
      });
    };

    writeLine('Historial Clinico OpenS', true, 18);
    y += 4;
    writeLine(`Paciente: ${currentPatient.name || `Paciente ${currentPatient.id}`}`, true, 12);
    writeLine(`ID: ${currentPatient.id}`, false, 11);
    y += 8;

    currentRecords.forEach((r:any, idx:number) => {
      const date = r.date || r.created_at || '';
      const dateStr = date ? new Date(date).toLocaleDateString('es') : 'Sin fecha';
      writeLine(`${idx + 1}. ${dateStr}`, true, 12);
      writeLine(`Motivo/Descripcion: ${r.description || 'Consulta'}`);
      if (r.diagnosis) writeLine(`Diagnostico: ${r.diagnosis}`);
      y += 6;
    });

    doc.save(`OpenS_Historial_${currentPatient.name}.pdf`);
    showToast('Historial PDF generado', 'success');
  } catch (err) {
    console.error('Error generando historial PDF:', err);
    showToast('No se pudo generar el historial PDF', 'error');
  } finally {
    downloadHistoryPdfBtn.textContent = prevText;
    downloadHistoryPdfBtn.disabled = !currentRecords.length;
    isGeneratingHistoryPdf = false;
  }
}

async function runMagicPipeline() {
  if (!currentPatient) return;
  
  const progress = $('pipeline-progress');
  const statusBar = $('pipeline-status-bar');
  const label = $('magic-finalize-label');
  const btn = $('magic-finalize-btn');
  const report = buildClinicalReport(true);

  if (!report.reason) {
    showToast('Debes registrar el motivo de llegada para finalizar.', 'error');
    return;
  }
  if (!report.diagnosisForFlow) {
    showToast('Debes registrar un diagnóstico final o análisis IA.', 'error');
    return;
  }
  
  statusBar.classList.remove('hidden');
  btn.setAttribute('disabled', 'true');
  
  const updateStep = (id:string, status:'active'|'success'|'error') => {
    const row = $(`step-row-${id}`);
    const dot = $(`step-dot-${id}`);
    if (status === 'active') {
      row.classList.remove('opacity-30', 'grayscale');
      dot.className = 'ml-auto w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse';
    } else if (status === 'success') {
      row.classList.remove('opacity-30', 'grayscale');
      dot.className = 'ml-auto w-1.5 h-1.5 rounded-full bg-emerald-500';
    }
  };

  try {
    // 1. IA Resumen
    updateStep('step-ai', 'active');
    progress.style.width = '25%';
    label.textContent = 'Consolidando resumen clínico...';

    let diagnosis = report.summaryForStorage;
    if (!draftOutput.value.trim() && conversation.length > 0) {
      const res = await patientService.generateDraftDiagnosis(currentPatient.id, conversation, finalDiagnosisInput.value.trim(), localModelSelect.value);
      draftOutput.value = res.draft_diagnosis;
      diagnosis = buildClinicalReport(true).summaryForStorage;
    }
    updateStep('step-ai', 'success');
    showToast('🧾 Resumen clínico consolidado', 'success');

    // 2. ElevenLabs
    updateStep('step-voice', 'active');
    progress.style.width = '50%';
    label.textContent = 'Sintetizando Voz...';
    await playVoice(diagnosis);
    updateStep('step-voice', 'success');

    // 3. Solana
    updateStep('step-solana', 'active');
    progress.style.width = '75%';
    label.textContent = 'Sellando en Blockchain...';
    const hash = await hashDiagnosis(diagnosis);
    const solRes = await anchorOnChain(hash, currentPatient.id, (s: string) => label.textContent = s);
    updateStep('step-solana', 'success');

    // 4. Supabase
    updateStep('step-db', 'active');
    progress.style.width = '100%';
    label.textContent = 'Guardando Todo...';
    await patientService.finalizeConsultation(
      currentPatient.id,
      diagnosis.slice(0, 500),
      hash,
      solRes.txSignature,
      report.reason
    );
    updateStep('step-db', 'success');
    
    showToast('🏥 Diagnóstico finalizado y guardado correctamente', 'success');
    label.textContent = '✨ Finalizado con Éxito';
    
    setTimeout(() => {
      statusBar.classList.add('hidden');
      progress.style.width = '0';
      btn.removeAttribute('disabled');
      label.textContent = '✨ Finalizar Consulta Automáticamente';
    }, 5000);

  } catch (err) {
    showToast('Error en el Pipeline', 'error');
    console.error(err);
    btn.removeAttribute('disabled');
    label.textContent = '❌ Reintentar Pipeline';
  }
}

function escapeHtml(value:string = '') {
  return value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');
}

function updateSyncBadge(state: 'syncing' | 'ok' | 'error') {
  if (!supabaseSyncBadge) return;
  if (state === 'syncing') {
    supabaseSyncBadge.textContent = 'Sincronizando';
    supabaseSyncBadge.className = 'px-3 py-1.5 rounded-full border border-slate-300 bg-slate-100 text-[11px] font-black uppercase tracking-wider text-slate-600';
  } else if (state === 'ok') {
    supabaseSyncBadge.textContent = 'Supabase online';
    supabaseSyncBadge.className = 'px-3 py-1.5 rounded-full border border-emerald-200 bg-emerald-50 text-[11px] font-black uppercase tracking-wider text-emerald-700';
  } else {
    supabaseSyncBadge.textContent = 'Error de sync';
    supabaseSyncBadge.className = 'px-3 py-1.5 rounded-full border border-red-200 bg-red-50 text-[11px] font-black uppercase tracking-wider text-red-700';
  }
}

function renderPatientsList(patients:any[]) {
  const pList = $('patients-list');
  if (!patients.length) {
    pList.innerHTML = '<p class="text-xs font-semibold text-slate-500 text-center py-4">No se encontraron pacientes.</p>';
    return;
  }

  pList.innerHTML = patients.map((p:any) => {
    const isActive = currentPatient && String(currentPatient.id) === String(p.id);
    return `
      <button class="patient-item w-full p-4 rounded-2xl border transition-all text-left group ${isActive ? 'bg-sky-50 border-sky-200 shadow-sm' : 'bg-slate-50 hover:bg-sky-50 border-slate-200 hover:border-sky-200'}" data-id="${p.id}">
        <p class="text-sm font-bold ${isActive ? 'text-sky-800' : 'text-slate-800 group-hover:text-sky-800'}">${escapeHtml(p.name || `Paciente ${p.id}`)}</p>
        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">${p.age || '—'} años · ID:${p.id}</p>
      </button>
    `;
  }).join('');
}

async function loadPatientHistory(patientId:number) {
  const recordsList = $('records-list');
  recordsList.innerHTML = '<div class="animate-pulse space-y-2"><div class="h-4 bg-slate-100 rounded w-full"></div><div class="h-4 bg-slate-100 rounded w-2/3"></div></div>';
  const records = await patientService.getPatientRecords(patientId);
  currentRecords = records;
  if (downloadHistoryPdfBtn) {
    if (records.length) {
      downloadHistoryPdfBtn.removeAttribute('disabled');
    } else {
      downloadHistoryPdfBtn.setAttribute('disabled', 'true');
    }
  }
  recordsList.innerHTML = records.map((r:any) => `
    <div class="p-3 bg-white border border-slate-200 rounded-xl mb-2 shadow-sm">
      <p class="text-[10px] font-bold text-sky-700 mb-1">${new Date(r.created_at).toLocaleDateString()}</p>
      <p class="text-xs font-bold text-slate-800">${escapeHtml(r.description || 'Consulta')}</p>
    </div>
  `).join('') || '<p class="text-xs text-slate-400 text-center py-4">Sin registros previos</p>';
}

async function selectPatient(patient:any) {
  const fresh = await patientService.getPatient(Number(patient.id));
  currentPatient = fresh || patient;
  conversation = [];
  if (reasonInput) reasonInput.value = '';
  if (finalDiagnosisInput) finalDiagnosisInput.value = '';
  if (draftOutput) draftOutput.value = '';
  if (downloadHistoryPdfBtn) downloadHistoryPdfBtn.setAttribute('disabled', 'true');
  historyPdfContainer?.classList.remove('hidden');
  chatMessages.innerHTML = `
    <div class="text-center text-slate-500 mt-24">
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-sky-50 border border-sky-100 flex items-center justify-center shadow-sm">
        <svg class="h-8 w-8 text-sky-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
      </div>
      <p class="font-bold text-slate-800 text-base">Paciente activo: ${escapeHtml(currentPatient.name || `Paciente ${currentPatient.id}`)}</p>
      <p class="text-[13px] font-medium mt-1 text-slate-500">El historial conversacional fue reiniciado para mantener trazabilidad clínica.</p>
    </div>
  `;
  patientLabel.textContent = currentPatient.name || `Paciente ${currentPatient.id}`;
  showToast(`Paciente ${currentPatient.name} seleccionado`, 'info');
  audioSummaryBtn?.classList.remove('hidden');
  $('diagnosis-container')?.classList.remove('hidden');
  $('magic-finalize-btn')?.removeAttribute('disabled');
  await loadPatientHistory(Number(currentPatient.id));
  renderPatientsList(allPatients);
  bindPatientListEvents();
}

function bindPatientListEvents() {
  document.querySelectorAll('.patient-item').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = (btn as HTMLElement).getAttribute('data-id');
      const selected = allPatients.find((p:any) => String(p.id) === id);
      if (!selected) return;
      await selectPatient(selected);
    });
  });
}

function closeSearchResults() {
  searchResults.classList.add('hidden');
  searchResults.innerHTML = '';
}

async function performSearch(query:string) {
  if (!query.trim()) {
    closeSearchResults();
    return;
  }
  activeSearchController?.abort();
  activeSearchController = new AbortController();
  updateSyncBadge('syncing');
  if (searchHint) searchHint.textContent = 'Consultando Supabase...';

  try {
    const results = await patientService.searchPatients(query.trim(), { signal: activeSearchController.signal });
    updateSyncBadge('ok');
    if (searchHint) searchHint.textContent = `${results.length} resultado(s) sincronizados`;

    if (!results.length) {
      searchResults.classList.remove('hidden');
      searchResults.innerHTML = '<p class="px-4 py-3 text-xs font-semibold text-slate-500">No hay coincidencias para la búsqueda.</p>';
      return;
    }

    searchResults.classList.remove('hidden');
    searchResults.innerHTML = results.map((p:any) => `
      <button class="search-result-item w-full text-left px-4 py-3 border-b border-slate-100 hover:bg-sky-50 transition-colors last:border-b-0" data-id="${p.id}">
        <p class="text-sm font-bold text-slate-800">${escapeHtml(p.name || `Paciente ${p.id}`)}</p>
        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">ID:${p.id}</p>
      </button>
    `).join('');

    document.querySelectorAll('.search-result-item').forEach(el => {
      el.addEventListener('click', async () => {
        const id = (el as HTMLElement).getAttribute('data-id');
        const selected = results.find((p:any) => String(p.id) === id);
        if (!selected) return;
        const exists = allPatients.some((p:any) => String(p.id) === String(selected.id));
        if (!exists) allPatients = [selected, ...allPatients];
        closeSearchResults();
        searchInput.value = selected.name || '';
        await selectPatient(selected);
      });
    });
  } catch (err) {
    if (err instanceof DOMException && err.name === 'AbortError') return;
    updateSyncBadge('error');
    if (searchHint) searchHint.textContent = 'No se pudo sincronizar con Supabase';
    showToast('Error sincronizando búsqueda con Supabase', 'error');
  }
}

function setupSearch() {
  searchInput?.addEventListener('input', () => {
    if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
    searchDebounceTimer = setTimeout(() => {
      performSearch(searchInput.value);
    }, 250);
  });

  searchInput?.addEventListener('focus', () => {
    if (searchInput.value.trim()) performSearch(searchInput.value);
  });

  document.addEventListener('click', (event) => {
    if (!searchContainer.contains(event.target as Node)) closeSearchResults();
  });
}

// --- Init & UI Interaction ---
async function init() {
  updateSyncBadge('syncing');
  try {
    allPatients = await patientService.searchPatients('');
    renderPatientsList(allPatients);
    bindPatientListEvents();
    updateSyncBadge('ok');
    if (searchHint) searchHint.textContent = `${allPatients.length} pacientes cargados desde Supabase`;
  } catch {
    renderPatientsList([]);
    updateSyncBadge('error');
    if (searchHint) searchHint.textContent = 'No se pudo cargar pacientes desde Supabase';
  }

  if (allPatients.length) {
    await selectPatient(allPatients[0]);
  }

  $('magic-finalize-btn')?.addEventListener('click', runMagicPipeline);
  setupSearch();
}

// --- Chat Form Handler ---
chatForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const text = chatInput.value.trim();
  if(!text || !currentPatient || isLoading) return;
  
  addMsg('user', text);
  conversation.push({role: 'user', content: text});
  chatInput.value = '';
  isLoading = true;
  sendBtn.setAttribute('disabled', 'true');
  
  const skeleton = addMsg('assistant', '');
  
  try {
    const data = await patientService.askAssistant(currentPatient.id, text, localModelSelect.value);
    skeleton.remove();
    const bubble = addMsg('assistant', '');
    conversation.push({role: 'assistant', content: data.response});
    
    streamText(data.response, bubble, () => {
      if (replyMode === 'audio') playVoice(data.response);
    });
    
    // Update badge
    const eng = data.engine_used;
    aiBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-${eng==='gemini'?'emerald':'amber'}-500 animate-pulse"></span>
                         <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Inference: ${eng==='gemini'?'Cloud':'Local'}</span>`;
  } catch(err) {
    skeleton.remove();
    addMsg('assistant', 'Lo siento, hubo un error en la conexión.');
  } finally {
    isLoading = false;
    sendBtn.removeAttribute('disabled');
  }
});

// --- PDF & Audio Summary ---
downloadPdfBasicBtn?.addEventListener('click', () => downloadClinicalPdf(false));
downloadPdfBtn?.addEventListener('click', () => downloadClinicalPdf(true));
downloadHistoryPdfBtn?.addEventListener('click', downloadHistoryPdf);

audioSummaryBtn?.addEventListener('click', async () => {
  if (!currentPatient) return;
  showToast('Generando resumen de audio...', 'info');
  const data = await patientService.askAssistant(currentPatient.id, "Haz un resumen de 2 líneas de mi historial.");
  await playVoice(data.response);
});

replyModeAudioBtn?.addEventListener('click', () => {
  setReplyMode('audio');
  showToast('Modo de respuesta: Audio', 'info');
});
replyModeTextBtn?.addEventListener('click', () => {
  setReplyMode('text');
  showToast('Modo de respuesta: Texto', 'info');
});

setReplyMode('audio');
init();
</script>
