---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---

<BaseLayout title="Acceso - OpenS">
  <Navbar />
  <main class="flex items-center justify-center min-h-[calc(100vh-4rem)] p-4">
    <div class="w-full max-w-md">
      <div class="glass rounded-3xl shadow-xl shadow-indigo-100/30 p-8">
        <!-- Tabs -->
        <div class="flex bg-slate-100 rounded-2xl p-1 mb-8">
          <button id="tab-login" class="flex-1 py-2.5 rounded-xl text-sm font-semibold bg-white text-indigo-700 shadow-sm transition-all">Iniciar Sesión</button>
          <button id="tab-register" class="flex-1 py-2.5 rounded-xl text-sm font-semibold text-slate-500 hover:text-slate-700 transition-all">Registrarse</button>
        </div>

        <!-- Login Form -->
        <form id="login-form" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Correo electrónico</label>
            <input type="email" placeholder="doctor@clinica.com" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all text-slate-800" required />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Contraseña</label>
            <input type="password" placeholder="••••••••" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all text-slate-800" required />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Rol</label>
            <select id="login-role" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all text-slate-800 bg-white">
              <option>Médico</option>
              <option>Administrador</option>
              <option>Paciente</option>
              <option>Seguros</option>
            </select>
          </div>
          <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-indigo-600 to-blue-600 text-white rounded-xl font-bold shadow-lg shadow-indigo-200 hover:shadow-xl hover:shadow-indigo-300 transition-all hover:-translate-y-0.5">
            Acceder
          </button>
        </form>

        <!-- Register Form (hidden by default) -->
        <form id="register-form" class="space-y-5 hidden">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Nombre completo</label>
            <input type="text" placeholder="Dr. García" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all text-slate-800" required />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Correo electrónico</label>
            <input type="email" placeholder="doctor@clinica.com" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all text-slate-800" required />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Contraseña</label>
            <input type="password" placeholder="Mínimo 8 caracteres" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all text-slate-800" required />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Rol</label>
            <select id="register-role" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all text-slate-800 bg-white">
              <option>Médico</option>
              <option>Administrador</option>
              <option>Paciente</option>
              <option>Seguros</option>
            </select>
          </div>
          <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-indigo-600 to-blue-600 text-white rounded-xl font-bold shadow-lg shadow-indigo-200 hover:shadow-xl hover:shadow-indigo-300 transition-all hover:-translate-y-0.5">
            Crear Cuenta
          </button>
        </form>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const tabLogin = document.getElementById('tab-login');
  const tabRegister = document.getElementById('tab-register');
  const loginForm = document.getElementById('login-form');
  const registerForm = document.getElementById('register-form');

  function activateTab(tab: HTMLElement, form: HTMLElement, otherTab: HTMLElement, otherForm: HTMLElement) {
    tab.classList.add('bg-white', 'text-indigo-700', 'shadow-sm');
    tab.classList.remove('text-slate-500');
    otherTab.classList.remove('bg-white', 'text-indigo-700', 'shadow-sm');
    otherTab.classList.add('text-slate-500');
    form.classList.remove('hidden');
    otherForm.classList.add('hidden');
  }

  function routeByRole(role: string) {
    const value = role.trim().toLowerCase();
    if (value === 'médico' || value === 'medico') return '/doctor';
    if (value === 'administrador') return '/admin';
    if (value === 'paciente') return '/paciente';
    if (value === 'seguros') return '/seguros';
    return '/';
  }

  tabLogin?.addEventListener('click', () => activateTab(tabLogin!, loginForm!, tabRegister!, registerForm!));
  tabRegister?.addEventListener('click', () => activateTab(tabRegister!, registerForm!, tabLogin!, loginForm!));

  loginForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const role = (document.getElementById('login-role') as HTMLSelectElement | null)?.value || 'Médico';
    window.location.href = routeByRole(role);
  });

  registerForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const role = (document.getElementById('register-role') as HTMLSelectElement | null)?.value || 'Médico';
    window.location.href = routeByRole(role);
  });
</script>
