---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="OpenS — Resilient AI for Human Healthcare">
  <div class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden text-slate-900 dot-grid">
    <!-- Scanner Line -->
    <div class="absolute top-1/2 left-0 w-full h-[1px] bg-blue-600/30 z-0 animate-scanner"></div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-white border border-slate-200 text-slate-500 font-mono text-[10px] uppercase tracking-[0.2em] mb-8 animate-fade-in">
        <span class="w-1.5 h-1.5 bg-blue-600 animate-led"></span>
        SYSTEM_READY: v2.5_RESILIENCE
      </div>

      <div class="medical-card p-12 mb-10 bg-white/80 backdrop-blur-md relative">
        <!-- Corner decorations -->
        <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-slate-300"></div>
        <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-slate-300"></div>
        <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-slate-300"></div>
        <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-slate-300"></div>

        <h1 class="text-5xl md:text-7xl font-black mb-6 tracking-tighter animate-fade-in uppercase">
          OpenS: <span class="text-blue-600">Resilient AI</span><br/>
          Human Healthcare
        </h1>

        <p class="text-lg md:text-xl font-mono text-slate-500 max-w-2xl mx-auto mb-10 leading-relaxed animate-fade-in uppercase" style="animation-delay: 0.1s;">
          Democratizando el diagnóstico médico en entornos de baja conectividad con arquitectura híbrida, voz de ElevenLabs e inmutabilidad en Solana.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 animate-fade-in" style="animation-delay: 0.2s;">
          <a href="/asistente" class="w-full sm:w-auto px-10 py-5 bg-blue-600 text-white font-bold uppercase tracking-widest transition-all glow-blue-hover">
            Launch Medical Demo
          </a>
          <a href="/admin" class="w-full sm:w-auto px-10 py-5 bg-white text-slate-800 border-technical font-bold uppercase tracking-widest transition-all hover:bg-slate-50">
            System Dashboard
          </a>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-px bg-slate-200 border-technical animate-fade-in" style="animation-delay: 0.4s;">
        {[
          { label: 'Local Inference', val: 'Qwen 2.5' },
          { label: 'Cloud Fallback', val: 'Gemini 1.5' },
          { label: 'Voice Sync', val: 'ElevenLabs' },
          { label: 'Security', val: 'Solana' }
        ].map(f => (
          <div class="p-6 bg-white">
            <p class="medical-label mb-2">{f.label}</p>
            <p class="medical-value">{f.val}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
