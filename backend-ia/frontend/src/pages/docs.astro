---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---

<BaseLayout title="Documentación Técnica — OpenS Project">
  <Navbar />
  <main class="max-w-5xl mx-auto px-6 py-12 dot-grid">
    <!-- Header Documentation -->
    <div class="mb-16 animate-fade-in">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-white border border-slate-200 text-slate-500 font-mono text-[10px] uppercase tracking-[0.2em] mb-4">
        <span class="w-1.5 h-1.5 bg-blue-600 animate-led"></span>
        DOCUMENT_TYPE: SYSTEM_SPECIFICATIONS
      </div>
      <h1 class="text-5xl font-black text-slate-900 tracking-tighter uppercase mb-4">Documentación Técnica</h1>
      <p class="text-sm font-mono text-slate-500 uppercase leading-relaxed">
        Guía integral sobre la arquitectura, diseño y operatividad del ecosistema OpenS.
      </p>
    </div>

    <!-- Navigation Index -->
    <div class="grid md:grid-cols-3 gap-px bg-slate-200 border-technical mb-16 animate-fade-in" style="animation-delay: 0.1s;">
      {['Arquitectura', 'Magic Pipeline', 'Identidad Visual'].map(item => (
        <a href={`#${item.toLowerCase().replace(' ', '-')}`} class="p-6 bg-white hover:bg-slate-50 transition-colors group">
          <p class="medical-label group-hover:text-blue-600">>> {item}</p>
        </a>
      ))}
    </div>

    <!-- Section: Arquitectura -->
    <section id="arquitectura" class="mb-24 animate-fade-in" style="animation-delay: 0.2s;">
      <div class="flex items-center gap-4 mb-8">
        <h2 class="text-2xl font-black uppercase tracking-tight">01. Arquitectura del Sistema</h2>
        <div class="h-px flex-1 bg-slate-200"></div>
      </div>
      
      <div class="medical-card p-8 bg-white mb-8">
        <p class="terminal-text mb-6">
          OpenS utiliza una arquitectura híbrida diseñada para la resiliencia en entornos clínicos críticos. 
          El sistema prioriza la ejecución local mediante nodos Ollama cuando la conectividad es inestable.
        </p>
        
        <!-- Flowchart: Architecture -->
        <div class="border-technical p-8 bg-slate-50 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[1px] bg-blue-600/10 animate-scanner"></div>
          <div class="flex flex-col items-center gap-8 font-mono text-[10px]">
            <div class="p-4 border-technical bg-white w-48 text-center">FRONTEND (ASTRO + TAILWIND)</div>
            <div class="text-blue-600">▼ API_REQUEST</div>
            <div class="p-4 border-technical bg-white w-48 text-center">BACKEND (FASTAPI)</div>
            <div class="flex gap-12">
              <div class="flex flex-col items-center gap-4">
                <div class="text-emerald-600">IF ONLINE</div>
                <div class="p-4 border-technical bg-emerald-50 w-32 text-center">GEMINI 1.5 FLASH</div>
              </div>
              <div class="flex flex-col items-center gap-4">
                <div class="text-amber-600">IF OFFLINE</div>
                <div class="p-4 border-technical bg-amber-50 w-32 text-center">OLLAMA LOCAL</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section: Magic Pipeline -->
    <section id="magic-pipeline" class="mb-24 animate-fade-in" style="animation-delay: 0.3s;">
      <div class="flex items-center gap-4 mb-8">
        <h2 class="text-2xl font-black uppercase tracking-tight">02. Magic Pipeline Sequence</h2>
        <div class="h-px flex-1 bg-slate-200"></div>
      </div>

      <div class="space-y-4">
        {[
          { step: '01', title: 'IA_FALLBACK', desc: 'Detección automática de conectividad y selección de motor de inferencia.' },
          { step: '02', title: 'TTS_ELEVEN_LABS', desc: 'Generación de síntesis de voz natural para el resumen diagnóstico.' },
          { step: '03', title: 'SOLANA_ANCHOR', desc: 'Generación de hash criptográfico e inmutabilidad en la Devnet de Solana.' },
          { step: '04', title: 'SUPABASE_SYNC', desc: 'Sincronización final de registros médicos en la base de datos distribuida.' }
        ].map(item => (
          <div class="medical-card p-6 flex gap-6 items-start group hover:border-blue-400 transition-colors">
            <span class="text-blue-600 font-mono font-bold">{item.step}</span>
            <div>
              <h3 class="font-mono font-bold text-slate-800 uppercase mb-2">{item.title}</h3>
              <p class="terminal-text text-slate-500">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section: Identidad Visual -->
    <section id="identidad-visual" class="mb-24 animate-fade-in" style="animation-delay: 0.4s;">
      <div class="flex items-center gap-4 mb-8">
        <h2 class="text-2xl font-black uppercase tracking-tight">03. Identidad Visual</h2>
        <div class="h-px flex-1 bg-slate-200"></div>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="medical-card p-8 bg-white">
          <h3 class="medical-label mb-6">PALETA_DE_COLORES</h3>
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-[#0052FF] border-technical"></div>
              <div>
                <p class="font-mono text-xs font-bold">#0052FF</p>
                <p class="medical-label">PRIMARY_ELECTRIC_BLUE</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-white border-technical"></div>
              <div>
                <p class="font-mono text-xs font-bold">#FFFFFF</p>
                <p class="medical-label">SURFACE_CLINIC_WHITE</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-[#1E293B] border-technical"></div>
              <div>
                <p class="font-mono text-xs font-bold">#1E293B</p>
                <p class="medical-label">DEEP_SLATE_TEXT</p>
              </div>
            </div>
          </div>
        </div>

        <div class="medical-card p-8 bg-white">
          <h3 class="medical-label mb-6">PRINCIPIOS_DE_DISEÑO</h3>
          <ul class="space-y-4 terminal-text">
            <li class="flex gap-2">
              <span class="text-blue-600">>></span>
              <span>Bordes técnicos de 1px en lugar de sombras (Estética IBM/Braun).</span>
            </li>
            <li class="flex gap-2">
              <span class="text-blue-600">>></span>
              <span>Uso extensivo de tipografía JetBrains Mono para datos.</span>
            </li>
            <li class="flex gap-2">
              <span class="text-blue-600">>></span>
              <span>Animaciones de "Scanner" y LEDs de estado para feedback táctico.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Footer Documentation -->
    <div class="mt-24 pt-12 border-t border-technical text-center">
      <p class="medical-label text-slate-400">END_OF_DOCUMENT — OPEN_S_PROJECT_V2.5</p>
    </div>
  </main>
</BaseLayout>

<style>
  section {
    scroll-margin-top: 2rem;
  }
</style>
