---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---

<BaseLayout title="Seguros - OpenS">
  <Navbar />
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-10">
      <h1 class="text-3xl font-extrabold text-slate-900">Gestión de Seguros</h1>
      <p class="text-slate-500 mt-2">Validación de coberturas y convenios institucionales.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl border border-slate-200 bg-white hover:shadow-lg hover:shadow-indigo-50 transition-all group">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="text-2xl">🏥</span>
          </div>
          <div>
            <h3 class="font-bold text-slate-800">Seguros Horizonte</h3>
            <span class="text-xs px-2 py-0.5 bg-green-100 text-green-700 rounded-full font-medium">Activo</span>
          </div>
        </div>
        <p class="text-sm text-slate-500">Cobertura general, emergencias y hospitalización.</p>
      </div>

      <div class="p-6 rounded-2xl border border-slate-200 bg-white hover:shadow-lg hover:shadow-indigo-50 transition-all group">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="text-2xl">💊</span>
          </div>
          <div>
            <h3 class="font-bold text-slate-800">MedSalud Plus</h3>
            <span class="text-xs px-2 py-0.5 bg-green-100 text-green-700 rounded-full font-medium">Activo</span>
          </div>
        </div>
        <p class="text-sm text-slate-500">Plan premium con consultas ilimitadas y farmacia.</p>
      </div>

      <div class="p-6 rounded-2xl border border-slate-200 bg-white hover:shadow-lg hover:shadow-indigo-50 transition-all group">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="text-2xl">🩺</span>
          </div>
          <div>
            <h3 class="font-bold text-slate-800">SeguroVida</h3>
            <span class="text-xs px-2 py-0.5 bg-amber-100 text-amber-700 rounded-full font-medium">Pendiente</span>
          </div>
        </div>
        <p class="text-sm text-slate-500">Convenio en revisión para ambulatorios públicos.</p>
      </div>
    </div>

    <section class="mt-10 p-6 rounded-2xl border border-slate-200 bg-white">
      <h2 class="text-xl font-bold text-slate-900 mb-1">Validación de Cobertura</h2>
      <p class="text-sm text-slate-500 mb-5">Verifica elegibilidad del paciente según convenio.</p>
      <form id="insurance-form" class="grid md:grid-cols-3 gap-4 items-end">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Paciente</label>
          <select id="insurance-patient" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 bg-white text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none">
            <option value="">Cargando...</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Aseguradora</label>
          <select id="insurance-provider" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 bg-white text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none">
            <option value="horizonte">Seguros Horizonte</option>
            <option value="medsalud">MedSalud Plus</option>
            <option value="segurovida">SeguroVida</option>
          </select>
        </div>
        <button type="submit" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-semibold transition-colors">
          Validar cobertura
        </button>
      </form>
      <div id="insurance-result" class="mt-5 text-sm text-slate-500">Selecciona un paciente para iniciar la validación.</div>
    </section>
  </main>
</BaseLayout>

<script>
  const API = '/api/v1';
  const providers = {
    horizonte: { name: 'Seguros Horizonte', status: 'Aprobada', color: 'text-emerald-700', bg: 'bg-emerald-50 border-emerald-200' },
    medsalud: { name: 'MedSalud Plus', status: 'Aprobada', color: 'text-emerald-700', bg: 'bg-emerald-50 border-emerald-200' },
    segurovida: { name: 'SeguroVida', status: 'Pendiente', color: 'text-amber-700', bg: 'bg-amber-50 border-amber-200' },
  } as const;

  async function apiFetch(path: string) {
    try { const r = await fetch(path); if (r.ok) return await r.json(); } catch {}
    try { const r = await fetch(`http://localhost:8001${path}`); if (r.ok) return await r.json(); } catch {}
    return null;
  }

  (async () => {
    const patientSelect = document.getElementById('insurance-patient') as HTMLSelectElement;
    const providerSelect = document.getElementById('insurance-provider') as HTMLSelectElement;
    const result = document.getElementById('insurance-result')!;
    const form = document.getElementById('insurance-form') as HTMLFormElement;

    const data = await apiFetch(`${API}/patients`);
    const patients = data?.patients || [];
    if (patients.length === 0) {
      patientSelect.innerHTML = '<option value="">Sin pacientes registrados</option>';
    } else {
      patientSelect.innerHTML = patients
        .map((p: any) => `<option value="${p.id}">${p.name || `Paciente ${p.id}`}</option>`)
        .join('');
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const patientId = patientSelect.value;
      const patientName = patientSelect.options[patientSelect.selectedIndex]?.textContent || 'Paciente';
      const provider = providers[providerSelect.value as keyof typeof providers];

      if (!patientId) {
        result.innerHTML = '<p class="text-red-500">No hay pacientes para validar en este momento.</p>';
        return;
      }

      result.innerHTML = `
        <div class="p-4 rounded-xl border ${provider.bg}">
          <p class="font-semibold text-slate-900">${patientName}</p>
          <p class="mt-1">Aseguradora: <strong>${provider.name}</strong></p>
          <p class="mt-1">Estado de cobertura: <strong class="${provider.color}">${provider.status}</strong></p>
          <p class="mt-1 text-xs text-slate-500">Referencia de validación: COV-${patientId}-${providerSelect.value.toUpperCase()}</p>
        </div>
      `;
    });
  })();
</script>
