---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/jpeg" href="/favicon.jpeg" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style is:global>
    body { 
      font-family: 'Inter', sans-serif; 
      background-color: #FFFFFF;
      color: #1E293B;
    }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
    
    /* Technical aesthetics */
    .technical-border { border: 1px solid #E2E8F0; }
    .medical-card { 
      background: white; 
      border: 1px solid #E2E8F0; 
      /* No shadows, just pure borders per requirements */
    }
    .medical-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #1E293B; }
    .medical-value { font-size: 1rem; font-weight: 600; color: #1E293B; }
    
    /* Dot grid pattern */
    .dot-grid {
      background-image: radial-gradient(#E2E8F0 1px, transparent 1px);
      background-size: 20px 20px;
    }

    /* Glow effect for buttons */
    .glow-blue-hover:hover {
      box-shadow: 0 0 15px rgba(0, 82, 255, 0.4);
      border-color: #0052FF;
    }
  </style>

  <script is:inline>
    // I18n initialization
    function updateLanguageUI(lang) {
      document.querySelectorAll('[data-es]').forEach(el => {
        el.textContent = lang === 'es' ? el.getAttribute('data-es') : el.getAttribute('data-en');
      });
      document.documentElement.lang = lang;
    }
    const savedLang = localStorage.getItem('opens_lang') || 'es';
    updateLanguageUI(savedLang);
    
    document.addEventListener('languageChanged', (e) => {
      updateLanguageUI(e.detail.lang);
    });
  </script>
</head>
<body class="min-h-screen dot-grid">
  <slot />
</body>
</html>
