---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/jpeg" href="/favicon.jpeg" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@400;700&family=Orbitron:wght@700;900&display=swap" rel="stylesheet">
  <style is:global>
    body { font-family: 'Inter', sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
    .font-retro { font-family: 'Orbitron', sans-serif; letter-spacing: 0.1em; }
    
    /* Variables for Light/Dark mode to keep the technical style */
    :root {
      --bg-color: #f1f5f9;
      --card-bg: white;
      --card-border: #e2e8f0;
      --text-color: #0f172a;
      --label-color: #64748b;
    }
    
    html.dark {
      --bg-color: #0f172a; /* Slate 900 */
      --card-bg: #1e293b; /* Slate 800 */
      --card-border: #334155; /* Slate 700 */
      --text-color: #f8fafc; /* Slate 50 */
      --label-color: #94a3b8; /* Slate 400 */
    }

    body { background-color: var(--bg-color); color: var(--text-color); transition: background-color 0.3s, color 0.3s; }
    .technical-border { border: 1px solid var(--card-border); }
    .medical-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); transition: background-color 0.3s, border-color 0.3s; }
    .medical-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--label-color); transition: color 0.3s; }
    .medical-value { font-size: 1rem; font-weight: 600; color: var(--text-color); transition: color 0.3s; }
  </style>
  <script is:inline>
    // Theme and Language initialization
    (function() {
      // Theme
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
      // Language
      const lang = localStorage.getItem('lang') || 'es';
      document.documentElement.setAttribute('data-lang', lang);
    })();
  </script>
</head>
<body class="min-h-screen transition-colors duration-300">
  <slot />
  
  <script is:inline>
    // i18n Translation logic
    function applyTranslations() {
      const lang = localStorage.getItem('lang') || 'es';
      const elements = document.querySelectorAll('[data-es][data-en]');
      elements.forEach(el => {
        el.textContent = el.getAttribute(`data-${lang}`);
      });
      // Also trigger a custom event so other components can react if needed
      window.dispatchEvent(new CustomEvent('languageChanged', { detail: lang }));
    }

    // Run on mount
    document.addEventListener('DOMContentLoaded', applyTranslations);
    // Listen for custom change events
    window.addEventListener('languageChanged', () => {
      // Small delay to ensure attributes were swapped if triggered manually
      setTimeout(applyTranslations, 10);
    });
  </script>
</body>
</html>
