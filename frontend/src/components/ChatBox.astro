---
---
<div class="flex-1 overflow-y-auto p-6 space-y-6 bg-white relative" id="chat-messages">
  <div class="text-center mt-32 text-slate-400">
    <div class="w-20 h-20 mx-auto mb-6 bg-slate-50 border border-technical flex items-center justify-center">
      <svg class="h-10 w-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
    </div>
    <h3 class="text-xl font-black text-slate-900 mb-2 uppercase tracking-tight" data-es="Workspace Médico" data-en="Medical Workspace">Workspace Médico</h3>
    <p class="max-w-xs mx-auto text-sm leading-relaxed font-mono text-slate-500" data-es="Selecciona un paciente del directorio para iniciar la consulta." data-en="Select a patient from the directory to start consultation.">Selecciona un paciente del directorio para iniciar la consulta.</p>
  </div>
</div>
<div class="bg-white border-t border-technical p-4">
  <div class="flex items-center justify-between mb-3 px-2">
    <div class="flex items-center gap-2" id="ai-badge">
      <span class="w-2 h-2 bg-slate-300"></span>
      <span class="text-[10px] font-mono font-bold text-slate-500 uppercase tracking-widest" data-es="Inferencia: Espera" data-en="Inference: Standby">Inferencia: Espera</span>
    </div>
    <div class="flex items-center gap-1 bg-slate-100 p-0.5 border border-technical">
      <button id="reply-mode-audio" class="px-3 py-1.5 text-[10px] font-mono font-bold uppercase tracking-wider transition-colors text-slate-500 hover:text-slate-900">Audio</button>
      <button id="reply-mode-text" class="px-3 py-1.5 text-[10px] font-mono font-bold uppercase tracking-wider transition-colors bg-slate-900 text-white">Texto</button>
    </div>
  </div>
  <form id="chat-form" class="relative group">
    <textarea id="chat-input" rows="2" class="w-full bg-slate-50 border border-technical text-slate-900 text-sm font-mono focus:ring-1 focus:ring-primary focus:border-primary block p-4 pr-16 resize-none transition-all outline-none" placeholder="Ingresa síntomas, medidas vitales o preguntas clínicas..." data-es-placeholder="Ingresa síntomas, medidas vitales o preguntas clínicas..." data-en-placeholder="Enter symptoms, vital signs or clinical questions..."></textarea>
    <button type="submit" id="send-btn" class="absolute right-3 bottom-3 p-2.5 bg-slate-900 hover:bg-black text-white transition-colors disabled:opacity-50 border border-slate-700 glow-blue-hover">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
    </button>
  </form>
</div>
