---
/**
 * ChatBox.astro — AI Chat Interface
 *
 * Core interaction panel. Renders the chat bubbles, skeleton loaders during
 * inference, suggestion chips, and the input form. The streaming text effect
 * gives the doctor immediate visual feedback while the full response loads.
 *
 * WHY CLIENT-SIDE RENDERING: Chat state is inherently dynamic. Astro's
 * island architecture lets us ship 0 JS for the static shell, with only
 * the chat logic hydrated on the client.
 */
---

<div class="flex-1 flex flex-col overflow-hidden">
  <!-- Header with AI engine badge -->
  <div class="bg-white border-b border-technical p-4 flex items-center justify-between z-10">
    <div>
      <h2 class="text-sm font-mono font-bold text-slate-800 flex items-center gap-2 uppercase tracking-tighter">
        <span class="text-blue-600">>></span>
        Diagnostic_Assistant_Terminal
      </h2>
      <div class="flex items-center gap-3 mt-1">
        <p id="patient-label" class="medical-label">INITIALIZING_PATIENT_RECORDS...</p>
        <button id="audio-summary-btn" class="hidden px-2 py-0.5 bg-blue-50 text-blue-700 font-mono text-[9px] font-bold border border-blue-200 uppercase tracking-widest transition-colors">AUDIO_STREAM</button>
      </div>
    </div>
    <div id="ai-badge" class="px-2 py-1 bg-slate-50 text-[10px] font-mono font-bold uppercase tracking-tight text-slate-600 border border-slate-200 flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 bg-slate-400 animate-led"></span>ENGINE: --
    </div>
  </div>

  <!-- Chat messages area -->
  <div id="chat-messages" class="flex-1 overflow-y-auto p-6 space-y-6 bg-white chat-scroll">
    <div id="chat-placeholder" class="text-center text-slate-500 mt-24">
      <div class="w-16 h-16 mx-auto mb-6 bg-slate-50 border-technical flex items-center justify-center relative">
        <div class="absolute inset-0 border-technical scale-90 opacity-30"></div>
        <span class="text-blue-600 font-mono font-bold text-2xl animate-led">OS</span>
      </div>
      <p class="font-mono font-bold text-slate-800 text-sm uppercase tracking-widest">OpenS Diagnostic Terminal</p>
      <p class="medical-label mt-2">AWAITING_INPUT_OR_SEQUENCE_SELECTION</p>
    </div>
  </div>

  <!-- Suggestion chips -->
  <div id="suggestions" class="px-6 py-4 border-t border-technical bg-white">
    <div class="flex flex-wrap gap-2">
      <button class="suggestion-btn px-3 py-1.5 medical-label bg-white border-technical text-slate-600 hover:bg-slate-50 hover:border-blue-400 transition-colors">PATHOLOGY_ANALYSIS</button>
      <button class="suggestion-btn px-3 py-1.5 medical-label bg-white border-technical text-slate-600 hover:bg-slate-50 hover:border-blue-400 transition-colors">HISTORY_SUMMARY</button>
      <button class="suggestion-btn px-3 py-1.5 medical-label bg-white border-technical text-slate-600 hover:bg-slate-50 hover:border-blue-400 transition-colors">CURRENT_MEDICATION</button>
      <button class="suggestion-btn px-3 py-1.5 medical-label bg-white border-technical text-slate-600 hover:bg-slate-50 hover:border-blue-400 transition-colors">DIFFERENTIAL_DIAGNOSIS</button>
    </div>
  </div>

  <!-- Input form -->
  <div class="border-t border-technical p-4 bg-white flex flex-col gap-4">
    <div class="flex items-center justify-between px-1">
      <div class="flex flex-wrap items-center gap-6">
        <div class="flex items-center gap-2">
          <span class="medical-label">RESPONSE_MODE:</span>
          <div class="flex items-center bg-slate-50 border-technical p-0.5">
            <button id="reply-mode-audio" type="button" class="px-3 py-1 text-[10px] font-mono font-bold uppercase tracking-tight transition-colors">
              AUDIO
            </button>
            <button id="reply-mode-text" type="button" class="px-3 py-1 text-[10px] font-mono font-bold uppercase tracking-tight transition-colors">
              TEXT
            </button>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="medical-label">LOCAL_ENGINE:</span>
          <select id="local-model-select" class="text-[10px] font-mono font-bold bg-slate-50 border-technical px-2 py-1 text-slate-700 outline-none cursor-pointer uppercase">
            <option value="qwen2.5:7b">QWEN_2.5</option>
            <option value="kimi-k2">KIMI_K2</option>
          </select>
        </div>
      </div>
    </div>
    <form id="chat-form" class="flex gap-4">
      <div class="flex-1 relative">
        <div class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 font-mono text-xs">>></div>
        <input id="chat-input" type="text" placeholder="ENTER_CONSULTATION_QUERY..." class="w-full pl-10 pr-4 py-3 bg-white border-technical text-slate-800 placeholder-slate-400 focus:border-blue-600 outline-none font-mono text-xs uppercase transition-all"/>
      </div>
      <button type="submit" id="send-btn" class="px-8 py-3 bg-blue-600 text-white font-bold uppercase tracking-widest text-xs transition-all hover:bg-blue-700 disabled:opacity-50">SEND_CMD</button>
    </form>
  </div>
</div>

<script>
  // Suggestion chips: on click, populate chat input and submit the form
  (function(){
    const suggestions = Array.from(document.querySelectorAll('.suggestion-btn'));
    const chatInput = document.getElementById('chat-input') as HTMLInputElement;
    const chatForm = document.getElementById('chat-form');
    if(!suggestions.length || !chatInput || !chatForm) return;

    suggestions.forEach(btn => {
      btn.addEventListener('click', () => {
        const txt = (btn.textContent || '').trim();
        if(!txt) return;
        // Fill input and trigger the existing submit handler on the page
        chatInput.value = txt;
        chatInput.focus();
        // Dispatch a submit event so the page-level listener handles sending
        const ev = new Event('submit', { bubbles: true, cancelable: true });
        chatForm.dispatchEvent(ev);
      });
    });
  })();
</script>
