---
<div class="medical-card p-4 relative" id="search-container">
  <div class="mb-4">
    <input type="text" id="patient-search" placeholder="Buscar paciente (ID, Nombre)" class="w-full bg-slate-50 border border-technical px-4 py-2.5 text-sm font-mono text-slate-900 focus:ring-1 focus:ring-primary focus:border-primary outline-none transition-all" autocomplete="off" />
    <p id="patient-search-hint" class="text-[10px] font-mono text-slate-400 mt-1.5 px-1"></p>
    <div id="search-results" class="hidden absolute top-[70px] left-4 right-4 bg-white border border-technical z-50 max-h-64 overflow-y-auto overflow-x-hidden"></div>
  </div>
  
  <!-- Tab switcher: Directorio Local vs Supabase -->
  <div class="flex items-center gap-0 mb-3 border-b border-technical">
    <button id="tab-local" class="flex-1 py-2 text-[10px] font-mono font-bold uppercase tracking-wider text-center border-b-2 border-primary text-primary transition-colors" data-es="Directorio Local" data-en="Local Directory">Directorio Local</button>
    <button id="tab-supabase" class="flex-1 py-2 text-[10px] font-mono font-bold uppercase tracking-wider text-center border-b-2 border-transparent text-slate-400 hover:text-slate-700 transition-colors" data-es="Supabase Cloud" data-en="Supabase Cloud">Supabase Cloud</button>
  </div>

  <div id="patients-list" class="space-y-1 max-h-[300px] overflow-y-auto pr-1"></div>
</div>

<div class="medical-card p-4 mt-4" id="history-pdf-container">
  <div class="flex justify-between items-center mb-4">
    <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-slate-800 border-b border-technical pb-2 w-full flex justify-between" data-es="Historial Clínico" data-en="Clinical History">
      <span data-es="Historial Clínico" data-en="Clinical History">Historial Clínico</span>
      <button id="download-history-pdf-btn" disabled class="px-2 py-0.5 bg-slate-50 text-slate-600 border border-technical text-[10px] font-mono font-bold uppercase tracking-wider hover:bg-primary hover:text-white disabled:opacity-30 transition-colors">PDF</button>
    </h3>
  </div>
  <div id="records-list" class="space-y-1 max-h-[400px] overflow-y-auto"></div>
</div>

<script>
  // Tab switching logic
  const tabLocal = document.getElementById('tab-local');
  const tabSupabase = document.getElementById('tab-supabase');
  
  function setActiveTab(tab) {
    const activeClasses = ['border-primary', 'text-primary'];
    const inactiveClasses = ['border-transparent', 'text-slate-400', 'hover:text-slate-700'];
    
    if (tab === 'local') {
      tabLocal.classList.add(...activeClasses);
      tabLocal.classList.remove(...inactiveClasses);
      tabSupabase.classList.remove(...activeClasses);
      tabSupabase.classList.add(...inactiveClasses);
    } else {
      tabSupabase.classList.add(...activeClasses);
      tabSupabase.classList.remove(...inactiveClasses);
      tabLocal.classList.remove(...activeClasses);
      tabLocal.classList.add(...inactiveClasses);
    }
    
    // Dispatch event for asistente.astro to handle
    document.dispatchEvent(new CustomEvent('patientTabChanged', { detail: { tab } }));
  }

  tabLocal?.addEventListener('click', () => setActiveTab('local'));
  tabSupabase?.addEventListener('click', () => setActiveTab('supabase'));
</script>
