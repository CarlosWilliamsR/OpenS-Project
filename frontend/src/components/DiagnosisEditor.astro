---
---
<div class="medical-card p-4 hidden" id="diagnosis-container">
  <h3 class="medical-label mb-3">Anotaciones Médicas</h3>
  <div class="space-y-4">
    <div>
      <label class="text-[11px] font-bold text-slate-500 uppercase">Motivo de Consulta</label>
      <textarea id="reason-input" rows="2" class="w-full mt-1 bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm focus:ring-blue-500 outline-none" placeholder="Ej: Dolor de cabeza persistente..."></textarea>
    </div>
    <div>
      <label class="text-[11px] font-bold text-slate-500 uppercase">Análisis IA Preliminar</label>
      <textarea id="draft-output" rows="3" readonly class="w-full mt-1 bg-slate-100 border border-slate-200 text-slate-500 rounded-lg p-2 text-xs font-mono resize-none"></textarea>
    </div>
    <div>
      <label class="text-[11px] font-bold text-slate-500 uppercase">Diagnóstico Final</label>
      <textarea id="final-diagnosis-input" rows="3" class="w-full mt-1 bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm focus:ring-emerald-500 outline-none border-l-4 border-l-emerald-500" placeholder="Diagnóstico conclusivo..."></textarea>
    </div>
    <div class="flex gap-2">
      <button id="download-pdf-basic-btn" class="flex-1 py-2 bg-slate-100 text-slate-700 font-bold text-xs rounded-lg hover:bg-slate-200">PDF Simple</button>
      <button id="download-pdf-btn" class="flex-1 py-2 bg-blue-100 text-blue-700 font-bold text-xs rounded-lg hover:bg-blue-200">PDF con IA</button>
    </div>
  </div>
</div>
