---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---

<BaseLayout title="Open-S — Resilient AI for Human Healthcare">
  <Navbar />
  <div class="relative min-h-[calc(100vh-65px)] flex flex-col items-center justify-center overflow-hidden text-slate-900 dark:text-slate-100 dot-grid">
    <!-- Scanner Line -->
    <div class="absolute top-1/2 left-0 w-full h-[1px] bg-blue-600/30 dark:bg-blue-400/30 z-0 animate-scanner"></div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 font-mono text-[10px] uppercase tracking-[0.2em] mb-8 animate-fade-in transition-colors">
        <span class="w-1.5 h-1.5 bg-blue-600 dark:bg-blue-400 animate-led"></span>
        <span data-es="SISTEMA_LISTO: v2.5_RESILIENCIA" data-en="SYSTEM_READY: v2.5_RESILIENCE">SISTEMA_LISTO: v2.5_RESILIENCIA</span>
      </div>

      <div class="medical-card p-12 mb-10 bg-white/80 dark:bg-slate-800/80 backdrop-blur-md relative transition-colors">
        <!-- Corner decorations -->
        <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-slate-300 dark:border-slate-600"></div>
        <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-slate-300 dark:border-slate-600"></div>
        <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-slate-300 dark:border-slate-600"></div>
        <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-slate-300 dark:border-slate-600"></div>

        <h1 class="text-5xl md:text-7xl font-black mb-6 tracking-tighter animate-fade-in uppercase">
          <span class="font-retro text-blue-600 dark:text-blue-400">Open-S:</span><br/>
          <span data-es="IA Resiliente para Salud" data-en="Resilient AI for Healthcare">IA Resiliente para Salud</span>
        </h1>

        <p class="text-lg md:text-xl font-mono text-slate-500 dark:text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed animate-fade-in uppercase transition-colors" style="animation-delay: 0.1s;" data-es="Democratizando el diagnóstico médico en entornos de baja conectividad con arquitectura híbrida, voz de ElevenLabs e inmutabilidad en Solana." data-en="Democratizing medical diagnosis in low-connectivity environments with hybrid architecture, ElevenLabs voice, and Solana immutability.">
          Democratizando el diagnóstico médico en entornos de baja conectividad con arquitectura híbrida, voz de ElevenLabs e inmutabilidad en Solana.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 animate-fade-in" style="animation-delay: 0.2s;">
          <a href="/asistente" class="w-full sm:w-auto px-10 py-5 bg-blue-600 dark:bg-blue-500 text-white font-bold uppercase tracking-widest transition-all glow-blue-hover" data-es="Iniciar Demo Médica" data-en="Launch Medical Demo">
            Iniciar Demo Médica
          </a>
          <a href="/admin" class="w-full sm:w-auto px-10 py-5 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 border-technical font-bold uppercase tracking-widest transition-all hover:bg-slate-50 dark:hover:bg-slate-700" data-es="Panel del Sistema" data-en="System Dashboard">
            Panel del Sistema
          </a>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-px bg-slate-200 dark:bg-slate-700 border-technical animate-fade-in transition-colors" style="animation-delay: 0.4s;">
        <div class="p-6 bg-white dark:bg-slate-800 transition-colors">
          <p class="medical-label mb-2" data-es="Inferencia Local" data-en="Local Inference">Inferencia Local</p>
          <p class="medical-value">Qwen 2.5</p>
        </div>
        <div class="p-6 bg-white dark:bg-slate-800 transition-colors">
          <p class="medical-label mb-2" data-es="Respaldo en Nube" data-en="Cloud Fallback">Respaldo en Nube</p>
          <p class="medical-value">Gemini 1.5</p>
        </div>
        <div class="p-6 bg-white dark:bg-slate-800 transition-colors">
          <p class="medical-label mb-2" data-es="Síntesis de Voz" data-en="Voice Sync">Síntesis de Voz</p>
          <p class="medical-value">ElevenLabs</p>
        </div>
        <div class="p-6 bg-white dark:bg-slate-800 transition-colors">
          <p class="medical-label mb-2" data-es="Seguridad" data-en="Security">Seguridad</p>
          <p class="medical-value">Solana</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
